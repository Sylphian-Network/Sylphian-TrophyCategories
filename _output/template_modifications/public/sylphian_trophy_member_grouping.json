{
    "template": "member_trophies",
    "description": "Group awarded trophies by category.",
    "execution_order": 10,
    "enabled": true,
    "action": "str_replace",
    "find": "\t\t\t<ol class=\"block-body\">\n\t\t\t\t<xf:foreach loop=\"$trophies\" value=\"$trophy\">\n\t\t\t\t\t<li class=\"block-row block-row--separated\">\n\t\t\t\t\t\t<div class=\"contentRow\">\n\t\t\t\t\t\t\t<span class=\"contentRow-figure contentRow-figure--text contentRow-figure--fixedSmall\">{$trophy.Trophy.trophy_points}</span>\n\t\t\t\t\t\t\t<div class=\"contentRow-main\">\n\t\t\t\t\t\t\t\t<span class=\"contentRow-extra\"><xf:date time=\"{$trophy.award_date}\" /></span>\n\t\t\t\t\t\t\t\t<h2 class=\"contentRow-header\">{$trophy.Trophy.title}</h2>\n\t\t\t\t\t\t\t\t<div class=\"contentRow-minor\">{$trophy.Trophy.description|raw}</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</li>\n\t\t\t\t</xf:foreach>\n\t\t\t</ol>",
    "replace": "<xf:if is=\"$groupedTrophies is not empty\">\n\t\t\t<div class=\"block-body\">\n\t\t\t\t<xf:foreach loop=\"$groupedTrophies\" value=\"$group\">\n\t\t\t\t\t<xf:if is=\"$group.category\">\n\t\t\t\t\t\t<h3 class=\"block-minorHeader\">{$group.category.title}</h3>\n\t\t\t\t\t<xf:elseif is=\"count($groupedTrophies) > 1\" />\n\t\t\t\t\t\t<h3 class=\"block-minorHeader\">{{ phrase('sylphian_trophy_other_trophies') }}</h3>\n\t\t\t\t\t</xf:if>\n\t\t\t\t\t<ol class=\"listPlain\">\n\t\t\t\t\t\t<xf:foreach loop=\"$group.items\" value=\"$trophy\">\n\t\t\t\t\t\t\t<li class=\"block-row block-row--separated\">\n\t\t\t\t\t\t\t\t<div class=\"contentRow\">\n\t<span class=\"contentRow-figure contentRow-figure--text contentRow-figure--fixedSmall\">{$trophy.Trophy.trophy_points}</span>\n\t<div class=\"contentRow-main\">\n\t\t<span class=\"contentRow-extra\"><xf:date time=\"{$trophy.award_date}\" /></span>\n\t\t<h2 class=\"contentRow-header\">{$trophy.Trophy.title}</h2>\n\t\t<div class=\"contentRow-minor\">{$trophy.Trophy.description|raw}</div>\n\t</div>\n</div>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</xf:foreach>\n\t\t\t\t\t</ol>\n\t\t\t\t</xf:foreach>\n\t\t\t</div>\n<xf:else />\n$0\n</xf:if>"
}