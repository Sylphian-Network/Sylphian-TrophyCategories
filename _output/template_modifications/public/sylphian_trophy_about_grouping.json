    "find": "\t\t\t\t<div class=\"block-row block-row--separated\">\n\t\t\t\t\t<h4 class=\"block-textHeader\">{{ phrase('trophies') }}</h4>\n\t\t\t\t\t<ol class=\"listPlain\">\n\t\t\t\t\t\t<xf:foreach loop=\"$trophies\" value=\"$trophy\">\n\t\t\t\t\t\t\t<li class=\"block-row\">\n\t\t\t\t\t\t\t\t<div class=\"contentRow\">\n\t\t\t\t\t\t\t\t\t<span class=\"contentRow-figure contentRow-figure--text contentRow-figure--fixedSmall\">{$trophy.Trophy.trophy_points}</span>\n\t\t\t\t\t\t\t\t\t<div class=\"contentRow-main\">\n\t\t\t\t\t\t\t\t\t\t<span class=\"contentRow-extra\"><xf:date time=\"{$trophy.award_date}\" /></span>\n\t\t\t\t\t\t\t\t\t\t<h2 class=\"contentRow-header\">{$trophy.Trophy.title}</h2>\n\t\t\t\t\t\t\t\t\t\t<div class=\"contentRow-minor\">{$trophy.Trophy.description|raw}</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</xf:foreach>\n\t\t\t\t\t</ol>\n\t\t\t\t</div>",
    "replace": "<xf:if is=\"$groupedTrophies is not empty\">\n\t\t\t\t<div class=\"block-row block-row--separated\">\n\t\t\t\t\t<xf:foreach loop=\"$groupedTrophies\" value=\"$group\">\n\t\t\t\t\t\t<h4 class=\"block-textHeader\">\n\t\t\t\t\t\t\t<xf:if is=\"$group.category\">\n\t\t\t\t\t\t\t\t{{ phrase('sylphian_trophy_x_trophies', {'title': $group.category.title}) }}\n\t\t\t\t\t\t\t<xf:elseif is=\"count($groupedTrophies) > 1\" />\n\t\t\t\t\t\t\t\t{{ phrase('sylphian_trophy_other_trophies') }}\n\t\t\t\t\t\t\t<xf:else />\n\t\t\t\t\t\t\t\t{{ phrase('trophies') }}\n\t\t\t\t\t\t\t</xf:if>\n\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t<ol class=\"listPlain\">\n\t\t\t\t\t\t\t<xf:foreach loop=\"$group.items\" value=\"$trophy\">\n\t\t\t\t\t\t\t\t<li class=\"block-row\">\n\t\t\t\t\t\t\t\t\t<div class=\"contentRow\">\n\t\t\t\t\t\t\t\t\t\t<span class=\"contentRow-figure contentRow-figure--text contentRow-figure--fixedSmall\">{$trophy.Trophy.trophy_points}</span>\n\t\t\t\t\t\t\t\t\t\t<div class=\"contentRow-main\">\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"contentRow-extra\"><xf:date time=\"{$trophy.award_date}\" /></span>\n\t\t\t\t\t\t\t\t\t\t\t<h2 class=\"contentRow-header\">{$trophy.Trophy.title}</h2>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"contentRow-minor\">{$trophy.Trophy.description|raw}</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t</xf:foreach>\n\t\t\t\t\t\t</ol>\n\t\t\t\t\t</xf:foreach>\n\t\t\t\t</div>\n<xf:else />\n$0\n</xf:if>"
